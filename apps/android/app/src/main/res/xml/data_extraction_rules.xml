<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Question answer drafts are sensitive and bound to a device-local Keystore key. -->
        <exclude domain="root" path="no_backup/question_drafts_v1" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/question_drafts_v1" />
    </device-transfer>
</data-extraction-rules>
